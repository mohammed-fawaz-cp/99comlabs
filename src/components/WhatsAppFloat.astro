---
// src/components/WhatsAppFloat.astro
const phoneNumber = '919745551513';
const defaultMessage = encodeURIComponent(
  'Hello 99COMLABS, I would like to discuss an engineering project.'
);
const whatsAppUrl = `https://wa.me/${phoneNumber}?text=${defaultMessage}`;
---

<!-- Persistent Floating WhatsApp Conversion CTA -->
<aside aria-label="Quick contact" class="fixed bottom-6 right-6 z-50">
  <div class="relative group">
    <!-- Accessible Hover/Focus Tooltip -->
    <div
      id="whatsapp-tooltip"
      role="tooltip"
      class="hidden sm:inline-block absolute right-16 top-1/2 -translate-y-1/2 whitespace-nowrap bg-slate-900 text-white text-xs font-semibold px-3 py-1.5 rounded-lg shadow-lg opacity-0 pointer-events-none group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-200 border border-slate-700"
    >
      Chat with an engineer (+91 9745551513)
      <!-- Tooltip Arrow -->
      <span class="absolute top-1/2 -right-1 -translate-y-1/2 border-4 border-transparent border-l-slate-900" aria-hidden="true"></span>
    </div>

    <!-- Floating Action Button (56px x 56px touch target, WCAG AA compliant contrast) -->
    <a
      href={whatsAppUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-describedby="whatsapp-tooltip"
      aria-label="Chat with 99COMLABS on WhatsApp (+91 9745551513)"
      data-analytics="whatsapp-float-click"
      class="flex items-center justify-center w-14 h-14 rounded-full bg-whatsapp-base hover:bg-whatsapp-hover active:bg-slate-900 text-white shadow-float hover:scale-105 active:scale-95 transition-all duration-200 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-white"
    >
      <!-- Pulsing decorative ping (disabled under prefers-reduced-motion) -->
      <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-whatsapp-bright opacity-25 pointer-events-none" aria-hidden="true"></span>

      <!-- High-contrast WhatsApp Vector Icon -->
      <svg
        class="w-7 h-7 text-white fill-current relative z-10"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.25-1.48-1.39-1.73-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43l-.48-.01c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"/>
      </svg>
      <span class="sr-only">Chat with 99COMLABS on WhatsApp (+91 9745551513)</span>
    </a>
  </div>
</aside>

