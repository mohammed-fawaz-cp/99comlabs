---
// src/pages/services/web-and-mobile-apps.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Custom Software & Web Development Kerala";
const pageDescription = "Custom web applications, mobile apps, and freelance software engineering in Kerala, India. Fast, responsive systems with 100% code ownership. Get a quote.";

const breadcrumbs = [
  { name: 'Services', url: '/services/' },
  { name: 'Web & Mobile Apps', url: '/services/web-and-mobile-apps/' }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <!-- JSON-LD Structured Data: Service, FAQPage & BreadcrumbList -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Custom Web and Mobile Application Development",
    "description": "Bespoke web applications, cross-platform mobile apps, customer booking portals, and offline-first billing software engineered by 99COMLABS in Kerala, India.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "99COMLABS",
      "telephone": "+91 9745551513",
      "url": "https://99comlabs.co.in/",
      "address": {
        "@type": "PostalAddress",
        "postalCode": "676304",
        "addressRegion": "Kerala",
        "addressCountry": "IN"
      }
    }
  })} />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Do I own the complete source code after the project is finished?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. You retain 100% legal ownership of all source code, database architectures, and design files upon final payment. We never trap you with proprietary monthly software licenses."
        }
      },
      {
        "@type": "Question",
        "name": "How long does it take to build a custom web or mobile application?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A focused business web portal typically launches within 2 to 4 weeks. Multi-platform mobile applications or comprehensive enterprise portals generally require 6 to 10 weeks depending on complexity."
        }
      },
      {
        "@type": "Question",
        "name": "Can our software operate when the internet connection goes down?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We frequently engineer offline-first architectures using local databases that allow your staff to continue billing or logging data offline, automatically synchronizing with the cloud once internet connectivity returns."
        }
      },
      {
        "@type": "Question",
        "name": "Can you modernize or upgrade our existing website or software?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Absolutely. We audit existing systems to fix mobile speed bottlenecks, improve user navigation, patch security vulnerabilities, and add modern automated workflows."
        }
      },
      {
        "@type": "Question",
        "name": "Can I hire 99COMLABS as a freelance software engineer or contract developer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. In addition to fixed-price turnkey projects, we provide flexible freelance and contract software engineering services for startups, local businesses in Kerala, and international clients seeking senior developer expertise."
        }
      }
    ]
  })} />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://99comlabs.co.in/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Services",
        "item": "https://99comlabs.co.in/services/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Web & Mobile Apps",
        "item": "https://99comlabs.co.in/services/web-and-mobile-apps/"
      }
    ]
  })} />

  <!-- Hero Section -->
  <section class="py-16 sm:py-20 bg-surface-light border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-content-primary mb-6 leading-tight">
          Custom Web Applications, Mobile Apps & Business Portals
        </h1>

        <p class="text-lg sm:text-xl text-content-secondary leading-relaxed mb-8">
          We build fast, secure software tailored to your daily operations. From customer booking portals and mobile apps to offline-first billing software, 99COMLABS creates reliable digital tools that save your staff time and help your business grow.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-white bg-brand-700 hover:bg-brand-800 rounded-lg shadow-sm transition-colors min-h-touch"
          >
            Get a Free Project Quote
          </a>
          <a
            href="https://wa.me/919745551513?text=Hello%2099COMLABS%2C%20I%20want%20to%20discuss%20custom%20software%20or%20mobile%20apps."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 text-sm font-semibold text-whatsapp-hover hover:text-white hover:bg-whatsapp-base border border-whatsapp-base/30 rounded-lg transition-colors min-h-touch"
          >
            <svg class="w-4 h-4 fill-current text-whatsapp-bright" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.025 3.312l-.727 2.654 2.721-.713c.978.534 1.773.816 2.748.816 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.769-5.766-5.769zm10.165 5.767c0 5.619-4.572 10.191-10.193 10.191-1.774 0-3.447-.461-4.908-1.265l-5.637 1.479 1.507-5.504c-.893-1.522-1.393-3.292-1.393-5.176 0-5.621 4.573-10.193 10.194-10.193 5.621 0 10.193 4.572 10.193 10.192z" />
            </svg>
            <span>Chat on WhatsApp (+91 9745551513)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="py-16 sm:py-20 bg-surface-muted border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-4">
          Why Off-the-Shelf Software Holds Your Business Back
        </h2>
        <p class="text-base text-content-secondary leading-relaxed mb-4">
          Most businesses start with generic software subscriptions or rigid website templates. Over time, recurring license fees pile up, while critical features your team actually needs remain missing. When your software fails to connect with your warehouse, accounting, or customer records, staff waste hours copying data across spreadsheets.
        </p>
        <p class="text-base text-content-secondary leading-relaxed">
          Worse, slow websites frustrate mobile visitors, causing them to leave before placing an order or calling your office. 99COMLABS builds software around your exact workflow—eliminating wasted subscription costs and streamlining your business.
        </p>
      </div>
    </div>
  </section>

  <!-- Deliverables Section -->
  <section class="py-16 sm:py-20 bg-surface-light border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-3">
          What We Deliver
        </h2>
        <p class="text-base text-content-secondary leading-relaxed">
          Tangible digital applications engineered for high performance, ease of use, and full business ownership.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 bg-surface-card rounded-xl border border-line-light shadow-card">
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Customer Booking & Self-Service Portals
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Enable clients to book services, place orders, track deliveries, and download invoices directly from their phones with instant WhatsApp or SMS confirmations.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light shadow-card">
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Android & iOS Mobile Applications
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Fast, user-friendly mobile apps for your customers or field workforce, designed to operate reliably even on slow 4G mobile connections.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light shadow-card">
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Custom Billing & POS Software
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Offline-first billing applications that process sales instantly during internet outages and sync securely with your cloud database when reconnected.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light shadow-card">
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Centralized Team & Inventory Dashboards
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Modern management screens that give managers real-time visibility over inventory levels, daily revenue, customer inquiries, and employee tasks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Step Process Section -->
  <section class="py-16 sm:py-20 bg-surface-muted border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-3">
          Our 4-Step Development Process
        </h2>
        <p class="text-base text-content-secondary leading-relaxed">
          From first conversation to final deployment, we keep our process clear, predictable, and transparent.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-surface-card rounded-xl border border-line-light">
          <div class="w-8 h-8 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-xs mb-3">1</div>
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">Discovery & Mapping</h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We analyze your business operations, identify time-wasting manual tasks, and outline the exact features required.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light">
          <div class="w-8 h-8 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-xs mb-3">2</div>
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">Clickable Prototype</h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We design screen layouts so you can test the user experience before writing code, accompanied by a fixed quote.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light">
          <div class="w-8 h-8 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-xs mb-3">3</div>
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">Build & Testing</h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We build your software using modern, secure standards, thoroughly testing speed, mobile responsiveness, and security.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light">
          <div class="w-8 h-8 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-xs mb-3">4</div>
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">Launch & Handover</h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We launch your application, train your team, and deliver 100% of the source code and logins with zero recurring license locks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 sm:py-20 bg-surface-light border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-3">
          Frequently Asked Questions
        </h2>
        <p class="text-base text-content-secondary leading-relaxed">
          Common questions about our custom web, mobile, and portal engineering services.
        </p>
      </div>

      <div class="max-w-3xl space-y-6">
        <div class="p-6 bg-surface-muted rounded-xl border border-line-light">
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">
            Do I own the complete source code after the project is finished?
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Yes. You retain 100% legal ownership of all source code, database architectures, and design files upon final payment. We never trap you with proprietary monthly software licenses.
          </p>
        </div>

        <div class="p-6 bg-surface-muted rounded-xl border border-line-light">
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">
            How long does it take to build a custom web or mobile application?
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            A focused business web portal typically launches within 2 to 4 weeks. Multi-platform mobile applications or comprehensive enterprise portals generally require 6 to 10 weeks depending on complexity.
          </p>
        </div>

        <div class="p-6 bg-surface-muted rounded-xl border border-line-light">
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">
            Can our software operate when the internet connection goes down?
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Yes. We frequently engineer offline-first architectures using local databases that allow your staff to continue billing or logging data offline, automatically synchronizing with the cloud once internet connectivity returns.
          </p>
        </div>

        <div class="p-6 bg-surface-muted rounded-xl border border-line-light">
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">
            Can you modernize or upgrade our existing website or software?
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Absolutely. We audit existing systems to fix mobile speed bottlenecks, improve user navigation, patch security vulnerabilities, and add modern automated workflows.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Banner -->
  <section class="py-16 sm:py-20 bg-surface-muted">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-brand-900 to-slate-900 text-white rounded-2xl p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
        <div class="space-y-2">
          <h2 class="font-heading text-2xl font-bold text-white">
            Ready to Build Your Custom Software?
          </h2>
          <p class="text-sm text-slate-200 max-w-xl leading-relaxed">
            Schedule a free consultation with our Kerala engineering team. We will review your requirements and provide a clear, itemized proposal within 24 business hours.
          </p>
          <div class="pt-2 text-xs text-slate-300">
            <span>Call directly: <strong class="text-white">+91 9745551513</strong></span>
            <span> • </span>
            <span>Email: <strong class="text-white">connect@99comlabs.co.in</strong></span>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold text-slate-900 bg-white hover:bg-slate-100 rounded-lg transition-colors whitespace-nowrap min-h-touch"
          >
            Request Your Free Quote
          </a>
          <a
            href="https://wa.me/919745551513?text=Hello%2099COMLABS%2C%20I%20want%20to%20discuss%20custom%20software%20or%20mobile%20apps."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 text-sm font-semibold text-white bg-whatsapp-base hover:bg-whatsapp-hover rounded-lg transition-colors whitespace-nowrap min-h-touch"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.025 3.312l-.727 2.654 2.721-.713c.978.534 1.773.816 2.748.816 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.769-5.766-5.769zm10.165 5.767c0 5.619-4.572 10.191-10.193 10.191-1.774 0-3.447-.461-4.908-1.265l-5.637 1.479 1.507-5.504c-.893-1.522-1.393-3.292-1.393-5.176 0-5.621 4.573-10.193 10.194-10.193 5.621 0 10.193 4.572 10.193 10.192z" />
            </svg>
            <span>WhatsApp Us</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
