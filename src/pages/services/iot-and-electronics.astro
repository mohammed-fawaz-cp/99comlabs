---
// src/pages/services/iot-and-electronics.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "IoT Hardware, Smart Sensors & PCB Kerala";
const pageDescription = "Smart IoT devices, custom PCB engineering, and remote telemetry systems. Connect physical equipment to modern cloud applications. Get a free quote.";

const breadcrumbs = [
  { name: 'Services', url: '/services/' },
  { name: 'IoT & Electronics', url: '/services/iot-and-electronics/' }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <!-- JSON-LD Structured Data: Service, FAQPage & BreadcrumbList -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Embedded Hardware, Electronics and IoT Engineering",
    "description": "Smart IoT devices, custom circuit board (PCB) design, microcontroller programming, and remote sensor telemetry engineered by 99COMLABS in Kerala, India.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "99COMLABS",
      "telephone": "+91 9745551513",
      "url": "https://99comlabs.co.in/",
      "address": {
        "@type": "PostalAddress",
        "postalCode": "676304",
        "addressRegion": "Kerala",
        "addressCountry": "IN"
      }
    }
  })} />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can we begin with a single working prototype before manufacturing in volume?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We always build and field-test a single working prototype to validate real-world performance and sensor accuracy before committing to larger production runs."
        }
      },
      {
        "@type": "Question",
        "name": "What communication channels do your IoT devices use to send data?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We choose the best communication method for your location, including local Wi-Fi, industrial Ethernet, 4G cellular SIM cards, or long-range low-power radio (LoRa) for remote agricultural sites."
        }
      },
      {
        "@type": "Question",
        "name": "Do I have to hire a separate software agency to build the mobile screen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. 99COMLABS handles both the physical electronics and the cloud software dashboards under one roof, guaranteeing seamless communication without third-party finger-pointing."
        }
      },
      {
        "@type": "Question",
        "name": "Do you provide freelance IoT engineering and hardware prototyping services?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We work on a freelance, contract, or advisory basis with hardware startups and industrial companies in Kerala and across India to design custom circuits, program firmware, and prototype IoT devices."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if the power or internet connection is interrupted?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our hardware controllers include local flash memory to record and store sensor readings during network outages. When connection is restored, all cached data uploads automatically to the cloud without data loss."
        }
      }
    ]
  })} />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://99comlabs.co.in/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Services",
        "item": "https://99comlabs.co.in/services/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "IoT & Electronics",
        "item": "https://99comlabs.co.in/services/iot-and-electronics/"
      }
    ]
  })} />

  <!-- Hero Section -->
  <section class="py-16 sm:py-20 bg-surface-light border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-content-primary mb-6 leading-tight">
          Smart IoT Devices, Custom Circuit Boards & Hardware Engineering
        </h1>

        <p class="text-lg sm:text-xl text-content-secondary leading-relaxed mb-8">
          We turn physical machines and industrial equipment into smart, connected devices. From custom circuit boards and microchips to live sensor monitoring on your phone, 99COMLABS connects physical hardware directly to the web.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-white bg-brand-700 hover:bg-brand-800 rounded-lg shadow-sm transition-colors min-h-touch"
          >
            Get a Free Hardware Quote
          </a>
          <a
            href="https://wa.me/919745551513?text=Hello%2099COMLABS%2C%20I%20want%20to%20discuss%20an%20IoT%20or%20hardware%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 text-sm font-semibold text-whatsapp-hover hover:text-white hover:bg-whatsapp-base border border-whatsapp-base/30 rounded-lg transition-colors min-h-touch"
          >
            <svg class="w-4 h-4 fill-current text-whatsapp-bright" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.025 3.312l-.727 2.654 2.721-.713c.978.534 1.773.816 2.748.816 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.769-5.766-5.769zm10.165 5.767c0 5.619-4.572 10.191-10.193 10.191-1.774 0-3.447-.461-4.908-1.265l-5.637 1.479 1.507-5.504c-.893-1.522-1.393-3.292-1.393-5.176 0-5.621 4.573-10.193 10.194-10.193 5.621 0 10.193 4.572 10.193 10.192z" />
            </svg>
            <span>Chat on WhatsApp (+91 9745551513)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="py-16 sm:py-20 bg-surface-muted border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-4">
          Stop Losing Money to Unmonitored Equipment and Manual Logging
        </h2>
        <p class="text-base text-content-secondary leading-relaxed mb-4">
          Businesses that depend on machinery, cold rooms, or agriculture often suffer unexpected losses. A refrigeration compressor fails overnight, destroying valuable stock before anyone notices. Water pumps run dry, burning expensive motors. Meanwhile, workers spend hours manually recording gauge numbers onto paper clipboards—resulting in delayed reports and human error.
        </p>
        <p class="text-base text-content-secondary leading-relaxed">
          Off-the-shelf consumer gadgets are rarely durable enough for industrial environments. 99COMLABS designs rugged, custom electronic controllers and sensor networks that alert you the moment readings leave safe limits.
        </p>
      </div>
    </div>
  </section>

  <!-- Deliverables Section -->
  <section class="py-16 sm:py-20 bg-surface-light border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-3">
          What We Deliver
        </h2>
        <p class="text-base text-content-secondary leading-relaxed">
          Complete hardware and firmware engineering designed for dependable real-world performance.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 bg-surface-card rounded-xl border border-line-light shadow-card">
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Custom Circuit Board (PCB) Design & Prototyping
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We engineer custom electronic boards fitted to your exact physical enclosures, operating voltages, and power limits, fabricated and tested for durability.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light shadow-card">
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Live Sensor Telemetry Networks
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Monitor temperature, humidity, tank levels, electrical current, vibration, and air quality in real time across multiple facilities.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light shadow-card">
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Automated Machinery & Motor Controllers
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Programmed electronic controllers that automatically switch motors, open safety valves, or toggle solar loads based on live sensor thresholds.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light shadow-card">
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Connected Web & Mobile Dashboards
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Clear mobile screens displaying live machine health, historic trend graphs, and automated WhatsApp or SMS emergency alerts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Step Process Section -->
  <section class="py-16 sm:py-20 bg-surface-muted border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-3">
          Our 4-Step Hardware Engineering Process
        </h2>
        <p class="text-base text-content-secondary leading-relaxed">
          From schematic design to field installation, our hardware engineering follows a rigorous, step-by-step methodology.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-surface-card rounded-xl border border-line-light">
          <div class="w-8 h-8 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-xs mb-3">1</div>
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">Feasibility & Sensors</h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We study your physical environment, evaluate power and wireless connectivity options (Wi-Fi, 4G, LoRa), and choose industrial-grade sensors.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light">
          <div class="w-8 h-8 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-xs mb-3">2</div>
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">Working Prototype</h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We design electronic schematics and assemble a functioning benchtop prototype for real-world proof-of-concept testing.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light">
          <div class="w-8 h-8 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-xs mb-3">3</div>
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">Enclosure & Trials</h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We package the electronics inside protective, weather-resistant enclosures and conduct extensive field stress trials.
          </p>
        </div>

        <div class="p-6 bg-surface-card rounded-xl border border-line-light">
          <div class="w-8 h-8 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-xs mb-3">4</div>
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">Cloud & Handover</h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We connect your hardware to secure cloud servers, train your maintenance team, and deliver complete schematics and production files.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 sm:py-20 bg-surface-light border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-3">
          Frequently Asked Questions
        </h2>
        <p class="text-base text-content-secondary leading-relaxed">
          Common questions about our smart IoT, electronics, and hardware automation services.
        </p>
      </div>

      <div class="max-w-3xl space-y-6">
        <div class="p-6 bg-surface-muted rounded-xl border border-line-light">
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">
            Can we begin with a single working prototype before manufacturing in volume?
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Yes. We always build and field-test a single working prototype to validate real-world performance and sensor accuracy before committing to larger production runs.
          </p>
        </div>

        <div class="p-6 bg-surface-muted rounded-xl border border-line-light">
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">
            What communication channels do your IoT devices use to send data?
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We choose the best communication method for your location, including local Wi-Fi, industrial Ethernet, 4G cellular SIM cards, or long-range low-power radio (LoRa) for remote agricultural sites.
          </p>
        </div>

        <div class="p-6 bg-surface-muted rounded-xl border border-line-light">
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">
            Do I have to hire a separate software agency to build the mobile screen?
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            No. 99COMLABS handles both the physical electronics and the cloud software dashboards under one roof, guaranteeing seamless communication without third-party finger-pointing.
          </p>
        </div>

        <div class="p-6 bg-surface-muted rounded-xl border border-line-light">
          <h3 class="font-heading text-base font-semibold text-content-primary mb-2">
            What happens if the power or internet connection is interrupted?
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Our hardware controllers include local flash memory to record and store sensor readings during network outages. When connection is restored, all cached data uploads automatically to the cloud without data loss.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Banner -->
  <section class="py-16 sm:py-20 bg-surface-muted">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-brand-900 to-slate-900 text-white rounded-2xl p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
        <div class="space-y-2">
          <h2 class="font-heading text-2xl font-bold text-white">
            Ready to Connect Your Physical Equipment?
          </h2>
          <p class="text-sm text-slate-200 max-w-xl leading-relaxed">
            Speak with our hardware solutions team. We will review your operational equipment requirements and outline a practical prototype roadmap within 24 business hours.
          </p>
          <div class="pt-2 text-xs text-slate-300">
            <span>Call directly: <strong class="text-white">+91 9745551513</strong></span>
            <span> • </span>
            <span>Email: <strong class="text-white">connect@99comlabs.co.in</strong></span>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold text-slate-900 bg-white hover:bg-slate-100 rounded-lg transition-colors whitespace-nowrap min-h-touch"
          >
            Request Your Hardware Quote
          </a>
          <a
            href="https://wa.me/919745551513?text=Hello%2099COMLABS%2C%20I%20want%20to%20discuss%20an%20IoT%20or%20hardware%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 text-sm font-semibold text-white bg-whatsapp-base hover:bg-whatsapp-hover rounded-lg transition-colors whitespace-nowrap min-h-touch"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.025 3.312l-.727 2.654 2.721-.713c.978.534 1.773.816 2.748.816 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.769-5.766-5.769zm10.165 5.767c0 5.619-4.572 10.191-10.193 10.191-1.774 0-3.447-.461-4.908-1.265l-5.637 1.479 1.507-5.504c-.893-1.522-1.393-3.292-1.393-5.176 0-5.621 4.573-10.193 10.194-10.193 5.621 0 10.193 4.572 10.193 10.192z" />
            </svg>
            <span>WhatsApp Us</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
