---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Technology Guides & Insights";
const pageDescription = "Practical technology, web development, IoT hardware, and cloud hosting guides for businesses in Kerala and India from the 99COMLABS engineering team.";

const breadcrumbs = [
  { name: 'Blog', url: '/blog/' }
];

const articles = [
  {
    slug: 'custom-website-cost-kerala-2026',
    title: 'How Much Does a Custom Website Cost in Kerala? (2026 Guide)',
    description: 'A transparent breakdown of real website development costs in Kerala for 2026. Understand pricing tiers, template pitfalls, hidden agency fees, and how to plan your budget.',
    category: 'Web & Mobile',
    categoryTag: 'web',
    readTime: '6 min read',
    date: 'March 15, 2026',
    isoDate: '2026-03-15T09:00:00+05:30',
    badgeClass: 'bg-blue-50 text-brand-700 border-blue-200'
  },
  {
    slug: 'iot-smart-sensors-cost-reduction-small-business',
    title: 'IoT for Small Businesses: 5 Ways Smart Sensors Cut Costs',
    description: 'Discover practical, low-cost ways connected IoT sensors prevent warehouse inventory spoilage, reduce commercial electricity bills, and automate manual machine monitoring.',
    category: 'IoT & Hardware',
    categoryTag: 'iot',
    readTime: '5 min read',
    date: 'March 20, 2026',
    isoDate: '2026-03-20T10:00:00+05:30',
    badgeClass: 'bg-amber-50 text-amber-800 border-amber-200'
  },
  {
    slug: 'cloud-hosting-vs-shared-hosting-guide',
    title: 'Cloud Hosting vs Shared Hosting: Which Does Your Company Need?',
    description: 'Is your business website sluggish or crashing during promotions? Understand the critical differences between cheap shared hosting and managed cloud servers.',
    category: 'Cloud & Security',
    categoryTag: 'cloud',
    readTime: '5 min read',
    date: 'March 25, 2026',
    isoDate: '2026-03-25T11:00:00+05:30',
    badgeClass: 'bg-purple-50 text-purple-800 border-purple-200'
  },
  {
    slug: 'why-website-not-getting-leads-fixes',
    title: 'Why Your Website Isn\'t Getting Inquiries (And 7 Proven Fixes)',
    description: 'Turn passive web visitors into direct phone calls and WhatsApp inquiries. Seven practical, jargon-free improvements to fix low-converting business websites in Kerala.',
    category: 'Digital Growth',
    categoryTag: 'growth',
    readTime: '6 min read',
    date: 'March 28, 2026',
    isoDate: '2026-03-28T14:00:00+05:30',
    badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-200'
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "99COMLABS Technology Guides & Insights",
    "description": pageDescription,
    "url": "https://99comlabs.co.in/blog/",
    "publisher": {
      "@type": "Organization",
      "name": "99COMLABS",
      "url": "https://99comlabs.co.in/",
      "logo": "https://99comlabs.co.in/images/logo.svg"
    }
  })} />

  <!-- Hero Header -->
  <section class="bg-surface-light border-b border-line-light py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-content-primary mb-4">
          Technology Guides & Engineering Insights
        </h1>
        <p class="text-base sm:text-lg text-content-secondary leading-relaxed">
          Clear, practical technology advice for Kerala and Indian business owners. We break down web development costs, hardware sensors, cloud infrastructure, and search optimization without confusing technical jargon.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter Chips & Article Grid -->
  <section class="py-12 sm:py-16 bg-surface-muted min-h-[500px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Category Filter Chips -->
      <div class="flex flex-wrap items-center gap-2 mb-10" role="toolbar" aria-label="Article categories">
        <span class="text-xs font-semibold uppercase tracking-wider text-content-muted mr-2">Filter Topics:</span>
        <a
          href="/blog/"
          class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-brand-700 text-white shadow-sm transition-colors focus-visible:ring-2 focus-visible:ring-brand-500"
          aria-current="page"
        >
          All Topics ({articles.length})
        </a>
        <a
          href="#web"
          class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-surface-light text-content-secondary hover:text-brand-700 hover:bg-surface-subtle border border-line-light transition-colors"
        >
          Web & Apps
        </a>
        <a
          href="#iot"
          class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-surface-light text-content-secondary hover:text-brand-700 hover:bg-surface-subtle border border-line-light transition-colors"
        >
          IoT & Hardware
        </a>
        <a
          href="#cloud"
          class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-surface-light text-content-secondary hover:text-brand-700 hover:bg-surface-subtle border border-line-light transition-colors"
        >
          Cloud & Security
        </a>
        <a
          href="#growth"
          class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-surface-light text-content-secondary hover:text-brand-700 hover:bg-surface-subtle border border-line-light transition-colors"
        >
          Digital Growth
        </a>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {articles.map((article) => (
          <article
            id={article.categoryTag}
            class="bg-surface-light rounded-xl border border-line-light p-6 sm:p-8 flex flex-col justify-between hover:border-brand-300 hover:shadow-md transition-all duration-200"
          >
            <div>
              <!-- Meta Row: Category Badge & Read Time -->
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold border ${article.badgeClass}`}>
                  {article.category}
                </span>
                <span class="text-xs font-medium text-content-muted flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {article.readTime}
                </span>
              </div>

              <!-- Article Headline -->
              <h2 class="font-heading text-xl sm:text-2xl font-bold text-content-primary mb-3 leading-snug">
                <a
                  href={`/blog/${article.slug}/`}
                  class="hover:text-brand-700 transition-colors focus-visible:outline-none focus-visible:underline"
                >
                  {article.title}
                </a>
              </h2>

              <!-- Summary -->
              <p class="text-content-secondary text-sm sm:text-base leading-relaxed mb-6">
                {article.description}
              </p>
            </div>

            <!-- Footer Row -->
            <div class="pt-4 border-t border-line-light flex items-center justify-between">
              <time datetime={article.isoDate} class="text-xs text-content-muted">
                {article.date}
              </time>
              <a
                href={`/blog/${article.slug}/`}
                class="inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 hover:underline min-h-touch py-1"
                aria-label={`Read full guide: ${article.title}`}
              >
                <span>Read Full Guide</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Consultation CTA Banner -->
      <div class="mt-16 bg-surface-light rounded-2xl border border-line-light p-8 sm:p-10 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="max-w-2xl">
          <h3 class="font-heading text-2xl font-bold text-content-primary mb-2">
            Have a Specific Engineering Question?
          </h3>
          <p class="text-content-secondary text-base leading-relaxed">
            Our engineers in Kerala can evaluate your website, mobile app idea, or IoT hardware project with zero sales pressure. Contact us directly for a free initial consultation.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
          <a
            href="https://wa.me/919745551513?text=Hello%2099COMLABS%2C%20I%20have%20a%20technical%20question%20from%20your%20blog."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-semibold text-white bg-whatsapp-base hover:bg-whatsapp-hover rounded-lg shadow-sm transition-colors min-h-touch"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
            </svg>
            <span>Ask on WhatsApp</span>
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 rounded-lg transition-colors min-h-touch"
          >
            Request a Free Quote
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
