---
// src/pages/support.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const pageTitle = "Client Support & Engineering Helpdesk";
const pageDescription = "Technical assistance, ticket generation, and dedicated engineering support for 99COMLABS clients in Kerala and across India.";

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Support', href: '/support/' },
];

const faqs = [
  {
    q: "How quickly does the engineering team respond to tickets?",
    a: "Critical production outages (server downtime, offline hardware) receive priority response within 1 to 2 hours. Standard defect reports and maintenance requests are acknowledged within 4 to 8 business hours."
  },
  {
    q: "How can I reference or track my submitted ticket?",
    a: "Every submission automatically generates an authentic reference ID (formatted as #99LAB-XXXXX). You will receive an instant email confirmation. You can also quote this reference on WhatsApp (+91 9745551513) for immediate status updates."
  },
  {
    q: "What is covered under standard post-launch support?",
    a: "All projects delivered by 99COMLABS include a standard warranty period (typically 30 to 90 days depending on contract terms) covering all software bug fixes, firmware stability adjustments, and server deployment verifications at zero additional charge."
  },
  {
    q: "Do you offer Annual Maintenance Contracts (AMC) for ongoing support?",
    a: "Yes. We provide continuous maintenance agreements covering regular security patches, automated off-site database backups, server monitoring, OS upgrades, and allocated monthly engineering hours for feature enhancements."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "99COMLABS Client Support Helpdesk",
    "url": "https://99comlabs.co.in/support/",
    "description": "Technical support, ticket submission, and engineering desk for 99COMLABS clients.",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://99comlabs.co.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Support",
          "item": "https://99comlabs.co.in/support/"
        }
      ]
    }
  })} />

<!-- Hero Section -->
  <section class="py-12 sm:py-16 bg-surface-light border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-content-primary mb-6 leading-tight">
          Client Support & Engineering Helpdesk
        </h1>

        <p class="text-base sm:text-lg text-content-secondary leading-relaxed mb-8">
          Direct engineering assistance for active client platforms, web applications, IoT devices, and cloud infrastructure. Open a prioritized support ticket or connect directly with our engineering team in Kerala.
        </p>

        <!-- Direct Contact Channels -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <!-- WhatsApp Support -->
          <a
            href="https://wa.me/919745551513?text=Support%20Inquiry%3A%20I%20need%20assistance%20with%20my%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-4 rounded-xl border border-line-light bg-surface-muted hover:border-whatsapp-base/50 hover:bg-emerald-50/30 transition-all duration-150 group"
          >
            <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.025 3.312l-.727 2.654 2.721-.713c.978.534 1.773.816 2.748.816 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.769-5.766-5.769zm10.165 5.767c0 5.619-4.572 10.191-10.193 10.191-1.774 0-3.447-.461-4.908-1.265l-5.637 1.479 1.507-5.504c-.893-1.522-1.393-3.292-1.393-5.176 0-5.621 4.573-10.193 10.194-10.193 5.621 0 10.193 4.572 10.193 10.192z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs font-medium text-content-muted">Priority WhatsApp</span>
              <span class="font-semibold text-sm text-content-primary group-hover:text-emerald-700 transition-colors">+91 9745551513</span>
            </div>
          </a>

          <!-- Hotline Phone -->
          <a
            href="tel:+919745551513"
            class="flex items-center gap-3 p-4 rounded-xl border border-line-light bg-surface-muted hover:border-brand-300 hover:bg-brand-50/30 transition-all duration-150 group"
          >
            <div class="w-10 h-10 rounded-lg bg-blue-100 text-brand-700 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs font-medium text-content-muted">Emergency Hotline</span>
              <span class="font-semibold text-sm text-content-primary group-hover:text-brand-700 transition-colors">+91 9745551513</span>
            </div>
          </a>

          <!-- Support Email -->
          <a
            href="mailto:connect@99comlabs.co.in"
            class="flex items-center gap-3 p-4 rounded-xl border border-line-light bg-surface-muted hover:border-brand-300 hover:bg-brand-50/30 transition-all duration-150 group"
          >
            <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs font-medium text-content-muted">Helpdesk Email</span>
              <span class="font-semibold text-xs text-content-primary group-hover:text-brand-700 transition-colors break-all">connect@99comlabs.co.in</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Support Form & Service Level Agreement Section -->
  <section class="py-16 sm:py-20 bg-surface-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Support Ticket Form Column -->
        <div class="lg:col-span-7">
          <div class="bg-surface-light p-6 sm:p-8 rounded-2xl border border-line-light shadow-sm">
            
            <div class="mb-6 pb-6 border-b border-line-light">
              <h2 class="font-heading text-2xl font-bold text-content-primary mb-2">
                Open a Support Ticket
              </h2>
              <p class="text-sm text-content-secondary">
                Submit issue details directly to our engineering queue. An authentic ticket ID will be generated upon submission.
              </p>
            </div>

            <!-- Ticket Success Confirmation (Hidden by default) -->
            <div id="support-success-container" class="hidden mb-6 p-6 rounded-xl bg-emerald-50 border border-emerald-200" role="status" aria-live="polite">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading text-lg font-bold text-emerald-900 mb-1">
                    Ticket Submitted Successfully!
                  </h3>
                  <p class="text-sm text-emerald-800 mb-3">
                    Your issue has been logged. Your engineering tracking reference is:
                  </p>
                  <div class="inline-block px-3 py-1.5 rounded-lg bg-emerald-200/60 border border-emerald-300 font-mono text-base font-bold text-emerald-950 mb-3">
                    <span id="generated-ticket-display">#99LAB-10001</span>
                  </div>
                  <p class="text-xs text-emerald-700">
                    A confirmation has been sent to your email. You can also quote this reference when messaging our team on WhatsApp.
                  </p>
                </div>
              </div>
            </div>

            <!-- Form Error Banner -->
            <div id="support-error-banner" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm" role="alert" aria-live="assertive">
              Please resolve the highlighted fields below before submitting your ticket.
            </div>

            <!-- The Interactive Support Ticket Form -->
            <form id="support-ticket-form" action="https://formsubmit.co/connect@99comlabs.co.in" method="POST" class="space-y-5" novalidate>
              
              <!-- FormSubmit Anti-Spam & Configuration -->
              <input type="text" name="_honey" class="hidden" style="display:none !important;" tabindex="-1" autocomplete="off" />
              <input type="hidden" name="_subject" id="formsubmit-subject-field" value="[99COMLABS Support] New Client Ticket" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="Ticket_ID" id="formsubmit-ticket-id" value="#99LAB-PENDING" />

              <!-- Client Name & Email -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="client-name" class="block text-sm font-semibold text-content-primary mb-1.5">
                    Your Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="client-name"
                    name="client_name"
                    required
                    placeholder="e.g. Rahul Menon"
                    class="w-full px-4 py-2.5 rounded-lg border border-line-medium bg-surface-light text-content-primary text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors"
                  />
                  <p id="client-name-error" class="hidden mt-1 text-xs text-red-600 font-medium">Please enter your name.</p>
                </div>

                <div>
                  <label for="client-email" class="block text-sm font-semibold text-content-primary mb-1.5">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="client-email"
                    name="client_email"
                    required
                    placeholder="name@company.com"
                    class="w-full px-4 py-2.5 rounded-lg border border-line-medium bg-surface-light text-content-primary text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors"
                  />
                  <p id="client-email-error" class="hidden mt-1 text-xs text-red-600 font-medium">Please enter a valid email address.</p>
                </div>
              </div>

              <!-- Phone & Project Domain -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="client-phone" class="block text-sm font-semibold text-content-primary mb-1.5">
                    Phone / WhatsApp <span class="text-content-muted font-normal text-xs">(optional)</span>
                  </label>
                  <input
                    type="tel"
                    id="client-phone"
                    name="client_phone"
                    placeholder="+91 98765 43210"
                    class="w-full px-4 py-2.5 rounded-lg border border-line-medium bg-surface-light text-content-primary text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors"
                  />
                </div>

                <div>
                  <label for="project-domain" class="block text-sm font-semibold text-content-primary mb-1.5">
                    Engineering Domain <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="project-domain"
                    name="project_domain"
                    required
                    class="w-full px-4 py-2.5 rounded-lg border border-line-medium bg-surface-light text-content-primary text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors"
                  >
                    <option value="" disabled selected>Select project category...</option>
                    <option value="Web & Software Applications">Web & Software Applications</option>
                    <option value="Smart IoT Devices & Electronics">Smart IoT Devices & Electronics</option>
                    <option value="Cloud Hosting & Infrastructure">Cloud Hosting & Infrastructure</option>
                    <option value="Digital Growth & Domain/SEO">Digital Growth & Domain/SEO</option>
                    <option value="General Technical Support">General Technical Support</option>
                  </select>
                  <p id="project-domain-error" class="hidden mt-1 text-xs text-red-600 font-medium">Please select your project category.</p>
                </div>
              </div>

              <!-- Urgency Level -->
              <div>
                <label for="ticket-priority" class="block text-sm font-semibold text-content-primary mb-1.5">
                  Severity / Urgency Level <span class="text-red-500">*</span>
                </label>
                <select
                  id="ticket-priority"
                  name="ticket_priority"
                  required
                  class="w-full px-4 py-2.5 rounded-lg border border-line-medium bg-surface-light text-content-primary text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors"
                >
                  <option value="Normal">Normal — General inquiry or minor cosmetic issue</option>
                  <option value="Medium" selected>Medium — Functionality impaired, non-blocking bug</option>
                  <option value="High">High — Critical feature broken affecting users</option>
                  <option value="Urgent">Urgent — Complete service outage or emergency downtime</option>
                </select>
              </div>

              <!-- Ticket Subject -->
              <div>
                <label for="ticket-subject" class="block text-sm font-semibold text-content-primary mb-1.5">
                  Subject / Summary <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="ticket-subject"
                  name="ticket_subject"
                  required
                  placeholder="e.g. SSL certificate renewal or API latency on checkout"
                  class="w-full px-4 py-2.5 rounded-lg border border-line-medium bg-surface-light text-content-primary text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors"
                />
                <p id="ticket-subject-error" class="hidden mt-1 text-xs text-red-600 font-medium">Please enter a summary of the issue.</p>
              </div>

              <!-- Ticket Description -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="ticket-details" class="block text-sm font-semibold text-content-primary">
                    Detailed Description & Error Logs <span class="text-red-500">*</span>
                  </label>
                  <span id="ticket-char-counter" class="text-xs text-content-muted">0 / 2000</span>
                </div>
                <textarea
                  id="ticket-details"
                  name="ticket_details"
                  rows="4"
                  maxlength="2000"
                  required
                  placeholder="Please describe what happened, expected behavior, steps to reproduce, or any error messages visible on screen."
                  class="w-full px-4 py-2.5 rounded-lg border border-line-medium bg-surface-light text-content-primary text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors resize-y"
                ></textarea>
                <p id="ticket-details-error" class="hidden mt-1 text-xs text-red-600 font-medium">Please provide details regarding the issue (at least 15 characters).</p>
              </div>

              <!-- Submit Button -->
              <div class="pt-2">
                <button
                  type="submit"
                  id="btn-submit-support"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 text-base font-semibold text-white bg-brand-700 hover:bg-brand-800 active:bg-brand-900 rounded-lg shadow-sm hover:shadow transition-all duration-150 focus-visible:ring-4 focus-visible:ring-brand-400 min-h-touch"
                >
                  <span id="btn-text">Submit Support Ticket</span>
                  <svg id="btn-icon" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </div>

            </form>

          </div>
        </div>

        <!-- Support Info & SLA Guidelines Column -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- SLA Information Card -->
          <div class="bg-surface-light p-6 sm:p-7 rounded-2xl border border-line-light shadow-sm">
            <h3 class="font-heading text-lg font-bold text-content-primary mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Service Level Targets</span>
            </h3>
            
            <ul class="space-y-3.5 text-sm">
              <li class="flex items-start gap-3">
                <strong class="text-xs font-bold uppercase text-red-700 tracking-wider">Critical:</strong>
                <span class="text-content-secondary"><strong>1 to 2 Hours</strong> — Complete website/app outage or cloud server downtime.</span>
              </li>
              <li class="flex items-start gap-3">
                <strong class="text-xs font-bold uppercase text-amber-700 tracking-wider">High:</strong>
                <span class="text-content-secondary"><strong>4 Hours</strong> — Major functionality defect blocking transactions or workflow.</span>
              </li>
              <li class="flex items-start gap-3">
                <strong class="text-xs font-bold uppercase text-brand-700 tracking-wider">Normal:</strong>
                <span class="text-content-secondary"><strong>1 Business Day</strong> — Minor bugs, UI refinements, or configuration adjustments.</span>
              </li>
            </ul>

            <div class="mt-6 pt-5 border-t border-line-light text-xs text-content-muted leading-relaxed">
              Active clients with dedicated Annual Maintenance Contracts (AMC) receive 24/7 automated monitoring and prioritized queue routing.
            </div>
          </div>

          <!-- What Happens Next Guide -->
          <div class="bg-surface-light p-6 sm:p-7 rounded-2xl border border-line-light shadow-sm">
            <h3 class="font-heading text-lg font-bold text-content-primary mb-4">
              What Happens After You Submit?
            </h3>
            <ol class="space-y-3 text-sm text-content-secondary">
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-brand-50 text-brand-700 font-bold flex items-center justify-center text-xs flex-shrink-0 mt-0.5">1</span>
                <span><strong>Instant ID Assignment:</strong> Your ticket is stamped with an authentic reference (#99LAB-XXXXX).</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-brand-50 text-brand-700 font-bold flex items-center justify-center text-xs flex-shrink-0 mt-0.5">2</span>
                <span><strong>Engineer Review:</strong> A software or electronics engineer in Kerala reviews the issue logs and reproduces the report.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-brand-50 text-brand-700 font-bold flex items-center justify-center text-xs flex-shrink-0 mt-0.5">3</span>
                <span><strong>Resolution & Deployment:</strong> The fix is verified in staging, deployed to production, and confirmed with your team.</span>
              </li>
            </ol>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Support FAQs Section -->
  <section class="py-16 sm:py-20 bg-surface-light border-t border-line-light">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-3">
          Support & Maintenance Questions
        </h2>
        <p class="text-content-secondary text-sm sm:text-base">
          Common questions regarding our engineering warranty, response time, and maintenance agreements.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-surface-muted border border-line-light rounded-xl p-5 sm:p-6 transition-colors open:bg-surface-light open:shadow-sm">
            <summary class="font-heading font-semibold text-base sm:text-lg text-content-primary cursor-pointer list-none flex items-center justify-between gap-4">
              <span>{faq.q}</span>
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-surface-subtle border border-line-light flex items-center justify-center text-content-muted group-open:rotate-180 transition-transform duration-200">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-sm text-content-secondary leading-relaxed pt-2 border-t border-line-light">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Client Ticket Handling Script -->
  <script is:inline>
    (function() {
      // Dynamic Ticket ID Generator (#99LAB-XXXXX)
      function generateTicketId() {
        var randomNum = Math.floor(10000 + Math.random() * 90000);
        return '#99LAB-' + randomNum;
      }

      var form = document.getElementById('support-ticket-form');
      if (!form) return;

      var currentTicketId = generateTicketId();
      var ticketIdField = document.getElementById('formsubmit-ticket-id');
      var subjectField = document.getElementById('formsubmit-subject-field');
      if (ticketIdField) ticketIdField.value = currentTicketId;

      // Character counter for details textarea
      var detailsArea = document.getElementById('ticket-details');
      var counter = document.getElementById('ticket-char-counter');
      if (detailsArea && counter) {
        detailsArea.addEventListener('input', function() {
          counter.textContent = detailsArea.value.length + ' / 2000';
        });
      }

      // Form validation & submission handler
      form.addEventListener('submit', function(e) {
        var hasError = false;

        var nameInput = document.getElementById('client-name');
        var nameError = document.getElementById('client-name-error');
        if (!nameInput.value.trim()) {
          nameError.classList.remove('hidden');
          nameInput.classList.add('border-red-500');
          hasError = true;
        } else {
          nameError.classList.add('hidden');
          nameInput.classList.remove('border-red-500');
        }

        var emailInput = document.getElementById('client-email');
        var emailError = document.getElementById('client-email-error');
        var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(emailInput.value.trim())) {
          emailError.classList.remove('hidden');
          emailInput.classList.add('border-red-500');
          hasError = true;
        } else {
          emailError.classList.add('hidden');
          emailInput.classList.remove('border-red-500');
        }

        var domainInput = document.getElementById('project-domain');
        var domainError = document.getElementById('project-domain-error');
        if (!domainInput.value) {
          domainError.classList.remove('hidden');
          domainInput.classList.add('border-red-500');
          hasError = true;
        } else {
          domainError.classList.add('hidden');
          domainInput.classList.remove('border-red-500');
        }

        var subjectInput = document.getElementById('ticket-subject');
        var subjectError = document.getElementById('ticket-subject-error');
        if (!subjectInput.value.trim()) {
          subjectError.classList.remove('hidden');
          subjectInput.classList.add('border-red-500');
          hasError = true;
        } else {
          subjectError.classList.add('hidden');
          subjectInput.classList.remove('border-red-500');
        }

        var detailsInput = document.getElementById('ticket-details');
        var detailsError = document.getElementById('ticket-details-error');
        if (!detailsInput.value.trim() || detailsInput.value.trim().length < 15) {
          detailsError.classList.remove('hidden');
          detailsInput.classList.add('border-red-500');
          hasError = true;
        } else {
          detailsError.classList.add('hidden');
          detailsInput.classList.remove('border-red-500');
        }

        var errorBanner = document.getElementById('support-error-banner');
        if (hasError) {
          e.preventDefault();
          if (errorBanner) errorBanner.classList.remove('hidden');
          return;
        }

        if (errorBanner) errorBanner.classList.add('hidden');

        // Update subject line with ticket ID
        if (subjectField && subjectInput) {
          subjectField.value = '[99COMLABS ' + currentTicketId + '] ' + subjectInput.value.trim();
        }

        // Show ticket confirmation modal / banner
        var successContainer = document.getElementById('support-success-container');
        var ticketDisplay = document.getElementById('generated-ticket-display');
        if (ticketDisplay) ticketDisplay.textContent = currentTicketId;
        if (successContainer) successContainer.classList.remove('hidden');
      });
    })();
  </script>
</BaseLayout>

