              <rect x="144" y="56" width="112" height="104" rx="4" fill="#0f172a" stroke="#334155" stroke-width="1"/>
              <text x="154" y="78" font-family="'Inter', sans-serif" font-size="10" fill="#94a3b8">WATER FLOW</text>
              <text x="154" y="106" font-family="'Space Grotesk', sans-serif" font-size="18" font-weight="700" fill="#ffffff">4.8 Bar</text>
              <text x="154" y="126" font-family="'Inter', sans-serif" font-size="9" fill="#10b981">Optimal Flow</text>
              <rect x="268" y="56" width="112" height="104" rx="4" fill="#064e3b" stroke="#059669" stroke-width="1"/>
