              <text x="278" y="106" font-family="'Space Grotesk', sans-serif" font-size="16" font-weight="700" fill="#ffffff">RUNNING</text>
              <rect x="278" y="122" width="92" height="26" rx="4" fill="#059669"/>
              <text x="288" y="139" font-family="'Inter', sans-serif" font-size="10" font-weight="600" fill="#ffffff">Remote Stop</text>
