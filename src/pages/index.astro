---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Software, IoT Hardware & Cloud Services";
const pageDescription = "99COMLABS is an engineering lab in Kerala, India building custom web & mobile apps, IoT smart devices, and reliable cloud systems for growing businesses.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "99COMLABS",
    "image": "https://99comlabs.co.in/images/logo.svg",
    "url": "https://99comlabs.co.in/",
    "telephone": "+91 9745551513",
    "email": "connect@99comlabs.co.in",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "[CONFIRM STREET ADDRESS]",
      "addressLocality": "Kottakkal",
      "addressRegion": "Kerala",
      "postalCode": "676304",
      "addressCountry": "IN"
    }
  })} />

  <!-- Hero Section with 5-Second Clarity Pitch -->
  <section class="relative bg-surface-light py-16 sm:py-24 border-b border-line-light overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-content-primary mb-6 leading-tight">
          We build custom software, smart IoT hardware, and cloud systems.
        </h1>

        <p class="text-lg sm:text-xl text-content-secondary leading-relaxed mb-8">
          From mobile and web applications to custom circuit boards and reliable cloud hosting. We help Indian businesses eliminate manual paperwork, automate equipment, and attract more customers.
        </p>

        <!-- Primary Conversion Actions -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-10">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-brand-700 hover:bg-brand-800 active:bg-brand-900 rounded-lg shadow-sm hover:shadow transition-all duration-150 focus-visible:ring-4 focus-visible:ring-brand-400 focus-visible:ring-offset-2 min-h-touch"
          >
            Get a Free Quote
          </a>
          <a
            href="tel:+919745551513"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-base font-semibold text-content-secondary hover:text-brand-700 bg-surface-muted hover:bg-surface-subtle border border-line-light rounded-lg transition-colors min-h-touch"
            aria-label="Call 99COMLABS directly at +91 9745551513"
          >
            <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call +91 9745551513</span>
          </a>
          <a
            href="https://wa.me/919745551513?text=Hello%2099COMLABS%2C%20I%20would%20like%20to%20discuss%20a%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 text-sm font-semibold text-whatsapp-hover hover:text-white hover:bg-whatsapp-base border border-whatsapp-base/30 rounded-lg transition-colors min-h-touch"
            aria-label="Chat with 99COMLABS on WhatsApp (+91 9745551513)"
          >
            <svg class="w-4 h-4 text-whatsapp-bright fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.025 3.312l-.727 2.654 2.721-.713c.978.534 1.773.816 2.748.816 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.769-5.766-5.769zm10.165 5.767c0 5.619-4.572 10.191-10.193 10.191-1.774 0-3.447-.461-4.908-1.265l-5.637 1.479 1.507-5.504c-.893-1.522-1.393-3.292-1.393-5.176 0-5.621 4.573-10.193 10.194-10.193 5.621 0 10.193 4.572 10.193 10.192z" />
            </svg>
            <span>WhatsApp Us</span>
          </a>
        </div>

        <!-- Trust Signals / Reassurance -->
        <div class="pt-6 border-t border-line-light grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs text-content-muted">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-600" aria-hidden="true"></span>
            <span>100% Code Ownership</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-600" aria-hidden="true"></span>
            <span>Zero License Lock-in</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-600" aria-hidden="true"></span>
            <span>Direct Engineer Access</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-600" aria-hidden="true"></span>
            <span>Transparent Pricing</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Engineering Disciplines Overview -->
  <section class="py-16 sm:py-20 bg-surface-muted border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-3">
          Our Four Engineering Specialties
        </h2>
        <p class="text-base text-content-secondary leading-relaxed">
          Clear, practical technology services tailored for Indian businesses, startups, and institutions. Every system is built to solve operational bottlenecks without unnecessary complexity.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <!-- Card 1: Web & Mobile Apps -->
        <div class="bg-surface-card p-6 rounded-xl border border-line-light shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-lg bg-brand-50 text-brand-700 flex items-center justify-center font-bold text-lg mb-4">
              01
            </div>
            <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
              Web & Mobile Apps
            </h3>
            <p class="text-sm text-content-secondary leading-relaxed mb-4">
              Custom business portals, offline-first billing software, and mobile apps built around your daily operational workflow.
            </p>
            <ul class="text-xs text-content-muted space-y-1.5 mb-6">
              <li>• Customer booking portals</li>
              <li>• Android & iOS mobile apps</li>
              <li>• POS & billing software</li>
            </ul>
          </div>
          <a href="/services/web-and-mobile-apps/" class="text-sm font-semibold text-brand-700 hover:text-brand-800 inline-flex items-center gap-1 group">
            <span>Explore apps & portals</span>
            <span class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Card 2: IoT & Electronics -->
        <div class="bg-surface-card p-6 rounded-xl border border-line-light shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-lg bg-brand-50 text-brand-700 flex items-center justify-center font-bold text-lg mb-4">
              02
            </div>
            <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
              IoT & Electronics
            </h3>
            <p class="text-sm text-content-secondary leading-relaxed mb-4">
              Custom circuit boards (PCBs), programmed microchips, and remote sensors that stream live machinery readings to your phone.
            </p>
            <ul class="text-xs text-content-muted space-y-1.5 mb-6">
              <li>• Custom PCB schematics</li>
              <li>• Smart motor controllers</li>
              <li>• Sensor telemetry networks</li>
            </ul>
          </div>
          <a href="/services/iot-and-electronics/" class="text-sm font-semibold text-brand-700 hover:text-brand-800 inline-flex items-center gap-1 group">
            <span>Explore hardware & IoT</span>
            <span class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Card 3: Cloud & Security -->
        <div class="bg-surface-card p-6 rounded-xl border border-line-light shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-lg bg-brand-50 text-brand-700 flex items-center justify-center font-bold text-lg mb-4">
              03
            </div>
            <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
              Cloud & Security
            </h3>
            <p class="text-sm text-content-secondary leading-relaxed mb-4">
              Dedicated cloud servers, automated daily off-site backups, and cyber security hardening for zero-downtime reliability.
            </p>
            <ul class="text-xs text-content-muted space-y-1.5 mb-6">
              <li>• Sub-second cloud hosting</li>
              <li>• Daily encrypted backups</li>
              <li>• 24/7 uptime monitoring</li>
            </ul>
          </div>
          <a href="/services/cloud-hosting-and-security/" class="text-sm font-semibold text-brand-700 hover:text-brand-800 inline-flex items-center gap-1 group">
            <span>Explore cloud & security</span>
            <span class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Card 4: Digital Growth -->
        <div class="bg-surface-card p-6 rounded-xl border border-line-light shadow-card hover:shadow-card-hover transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-lg bg-brand-50 text-brand-700 flex items-center justify-center font-bold text-lg mb-4">
              04
            </div>
            <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
              Digital Growth
            </h3>
            <p class="text-sm text-content-secondary leading-relaxed mb-4">
              Local Kerala and national Google search optimization, brand identity, and fast inquiry landing pages.
            </p>
            <ul class="text-xs text-content-muted space-y-1.5 mb-6">
              <li>• Kerala local SEO & Google Maps</li>
              <li>• High-converting landing pages</li>
              <li>• Brand logos & identity</li>
            </ul>
          </div>
          <a href="/services/digital-growth-and-branding/" class="text-sm font-semibold text-brand-700 hover:text-brand-800 inline-flex items-center gap-1 group">
            <span>Explore digital growth</span>
            <span class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="text-center">
        <a
          href="/services/"
          class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:text-brand-800 bg-surface-card px-5 py-2.5 rounded-lg border border-line-light shadow-sm hover:shadow transition-all"
        >
          <span>View all services & technical specifications</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4-Step Plain-English Process -->
  <section class="py-16 sm:py-20 bg-surface-light border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14">
        <span class="text-xs font-semibold tracking-wider text-brand-700 uppercase mb-2 block">
          How We Work
        </span>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-3">
          Our Simple 4-Step Engineering Process
        </h2>
        <p class="text-base text-content-secondary leading-relaxed">
          No complicated technical jargon, hidden retainers, or unexpected delays. Here is how we take your project from initial idea to working system.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Step 1 -->
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-sm mb-4">
            1
          </div>
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Free Consultation & Scope
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We review your operational challenges, discuss technical feasibility, and map out the exact software, hardware, or cloud features you need.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-sm mb-4">
            2
          </div>
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Prototype & Clear Estimate
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We deliver a tangible design prototype or hardware mock-up along with a transparent milestone estimate and realistic delivery schedule.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-sm mb-4">
            3
          </div>
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Build & Rigorous Testing
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            Our engineers build your system using clean, robust standards, thoroughly testing for speed, mobile responsiveness, and security.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-brand-700 text-white font-bold flex items-center justify-center text-sm mb-4">
            4
          </div>
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Launch, Training & Handover
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed">
            We deploy the system to live servers, train your staff, and deliver 100% of all source code, design files, and administrative logins.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Authentic Projects Showcase (Teaser) -->
  <section class="py-16 sm:py-20 bg-surface-muted border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold tracking-wider text-brand-700 uppercase mb-2 block">
            Proven Systems
          </span>
          <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary mb-2">
            Real Solutions Built for Real Operations
          </h2>
          <p class="text-base text-content-secondary leading-relaxed">
            A selection of authentic engineering projects developed by 99COMLABS for real-world enterprise operations.
          </p>
        </div>
        <a
          href="/projects/"
          class="text-sm font-semibold text-brand-700 hover:text-brand-800 inline-flex items-center gap-1 self-start sm:self-auto"
        >
          <span>View all projects & architecture</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Project 1: POS Billing -->
        <div class="bg-surface-card rounded-xl border border-line-light p-6 shadow-card hover:shadow-card-hover transition-all">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-50 text-brand-700 border border-blue-200">
              Software Application
            </span>
            <span class="text-xs text-content-subtle">Retail & POS</span>
          </div>
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Enterprise Billing Application
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed mb-4">
            Offline-first point of sale system with instant receipt generation, local database caching, and automated cloud synchronization.
          </p>
          <div class="flex flex-wrap gap-1.5 text-xs text-content-muted">
            <span class="px-2 py-0.5 rounded bg-surface-subtle">Electron</span>
            <span class="px-2 py-0.5 rounded bg-surface-subtle">Next.js</span>
            <span class="px-2 py-0.5 rounded bg-surface-subtle">SQLite</span>
          </div>
        </div>

        <!-- Project 2: Life & Tree IoT -->
        <div class="bg-surface-card rounded-xl border border-line-light p-6 shadow-card hover:shadow-card-hover transition-all">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
              IoT & Hardware
            </span>
            <span class="text-xs text-content-subtle">Agriculture</span>
          </div>
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            Life & Tree — Smart Motor Automation
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed mb-4">
            Industrial IoT telemetry system monitoring water pressure and electricity, with remote motor switching via mobile dashboard.
          </p>
          <div class="flex flex-wrap gap-1.5 text-xs text-content-muted">
            <span class="px-2 py-0.5 rounded bg-surface-subtle">MQTT</span>
            <span class="px-2 py-0.5 rounded bg-surface-subtle">Embedded C</span>
            <span class="px-2 py-0.5 rounded bg-surface-subtle">Node.js</span>
          </div>
        </div>

        <!-- Project 3: MyPDF -->
        <div class="bg-surface-card rounded-xl border border-line-light p-6 shadow-card hover:shadow-card-hover transition-all">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-purple-50 text-purple-700 border border-purple-200">
              Mobile Application
            </span>
            <span class="text-xs text-content-subtle">Productivity</span>
          </div>
          <h3 class="font-heading text-lg font-semibold text-content-primary mb-2">
            MyPDF — Document Processing Suite
          </h3>
          <p class="text-sm text-content-secondary leading-relaxed mb-4">
            Cross-platform mobile utility for instant scanning, signing, and local encryption of business documents without third-party cloud leaks.
          </p>
          <div class="flex flex-wrap gap-1.5 text-xs text-content-muted">
            <span class="px-2 py-0.5 rounded bg-surface-subtle">Flutter</span>
            <span class="px-2 py-0.5 rounded bg-surface-subtle">Dart</span>
            <span class="px-2 py-0.5 rounded bg-surface-subtle">Riverpod</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Quote & Inquiries Section -->
  <section class="py-16 sm:py-20 bg-surface-light border-b border-line-light" id="quote-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-brand-900 via-brand-800 to-slate-900 text-white rounded-2xl p-8 sm:p-12 lg:p-16 shadow-xl">
        <div class="max-w-3xl">
          <span class="text-xs font-semibold tracking-wider text-brand-300 uppercase mb-3 block">
            Start Your Project
          </span>
          <h2 class="font-heading text-3xl sm:text-4xl font-bold text-white mb-4 leading-tight">
            Ready to Build Your Next System?
          </h2>
          <p class="text-base sm:text-lg text-slate-200 leading-relaxed mb-8">
            Tell us about your project requirements. Our engineering team in Kerala will evaluate your specifications and provide a realistic, itemized quote within 24 business hours.
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
            <a
              href="/contact/"
              class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-slate-900 bg-white hover:bg-slate-100 rounded-lg shadow transition-colors min-h-touch"
            >
              Request a Free Project Quote
            </a>
            <a
              href="https://wa.me/919745551513?text=Hello%2099COMLABS%2C%20I%20would%20like%20to%20get%20a%20quote%20for%20my%20project."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-base font-semibold text-white bg-whatsapp-base hover:bg-whatsapp-hover rounded-lg transition-colors min-h-touch"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.025 3.312l-.727 2.654 2.721-.713c.978.534 1.773.816 2.748.816 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.769-5.766-5.769zm10.165 5.767c0 5.619-4.572 10.191-10.193 10.191-1.774 0-3.447-.461-4.908-1.265l-5.637 1.479 1.507-5.504c-.893-1.522-1.393-3.292-1.393-5.176 0-5.621 4.573-10.193 10.194-10.193 5.621 0 10.193 4.572 10.193 10.192z" />
              </svg>
              <span>Instant WhatsApp Quote</span>
            </a>
          </div>

          <div class="pt-6 border-t border-slate-700/60 flex flex-col sm:flex-row sm:items-center gap-6 text-sm text-slate-300">
            <div>
              <span>Direct Phone: </span>
              <a href="tel:+919745551513" class="font-semibold text-white hover:text-brand-300 transition-colors">
                +91 9745551513
              </a>
            </div>
            <div>
              <span>Direct Email: </span>
              <a href="mailto:connect@99comlabs.co.in" class="font-semibold text-white hover:text-brand-300 transition-colors">
                connect@99comlabs.co.in
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--
    MANDATORY HONEST CONTENT STANDARD (R4):
    The Testimonials section is strictly hidden until the business owner provides authentic,
    verified client reviews as tracked in Handover Catalog item:
    [ADD REAL TESTIMONIAL + NAME + COMPANY]
    DO NOT unhide this section with fabricated quotes, stock logos, or fictional clients.
  -->
  <section id="testimonials" class="hidden" aria-hidden="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="font-heading text-2xl font-bold text-content-primary mb-4">
        What Our Clients Say
      </h2>
      <div class="p-6 bg-surface-muted rounded-xl border border-line-light">
        <p class="text-content-secondary">[ADD REAL TESTIMONIAL + NAME + COMPANY]</p>
      </div>
    </div>
  </section>

  <!-- Preserved Helpdesk Support Banner -->
  <section class="py-12 bg-surface-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-surface-card border border-line-light rounded-xl p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="space-y-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-xs font-mono font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
            #99LAB Support Portal
          </span>
          <h2 class="font-heading text-xl font-bold text-content-primary">
            Need support for an existing engineering system?
          </h2>
          <p class="text-sm text-content-secondary max-w-xl">
            Access our client helpdesk to generate a ticket, request bug fixes, or view technical service FAQs.
          </p>
        </div>
        <a
          href="/support/"
