              <h3 class="font-heading text-xl font-bold text-content-primary mb-3">
                Life & Tree — Smart Motor Automation
              </h3>
              <p class="text-sm text-content-secondary leading-relaxed mb-6">
                An industrial IoT hardware and telemetry solution connecting agricultural water pumps and commercial motors to a secure mobile dashboard. Prevents costly motor burnouts with automatic power cutoffs during voltage surges or dry runs, and lets operators monitor equipment remotely from anywhere.
              </p>
            </div>
            <a href="/projects/#industrial-iot" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800">
              <span>Read project details</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Quote & Inquiries Section -->
  <section class="py-16 sm:py-20 bg-surface-light border-b border-line-light" id="quote-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-brand-900 via-brand-800 to-slate-900 text-white rounded-2xl p-8 sm:p-12 lg:p-16 shadow-xl">
        <div class="max-w-3xl">
          <span class="text-xs font-semibold tracking-wider text-brand-300 uppercase mb-3 block">
            Start Your Project
