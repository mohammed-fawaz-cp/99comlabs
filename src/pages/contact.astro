---
// src/pages/contact.astro
/**
 * Contact Page — Primary Conversion Hub & Inquiry Center
 * 
 * Part of 99COMLABS Milestone 3 (Conversion Engine, SEO & Documentation)
 * Features:
 * 1. Single H1: "Let's Discuss Your Next Project"
 * 2. Embedded accessible ContactForm component with validation, honeypot, and loading feedback.
 * 3. Direct contact channels card:
 *    - Phone: +91 9745551513 (tel:+919745551513)
 *    - WhatsApp: +91 9745551513 (https://wa.me/919745551513)
 *    - Official Inquiries Email: connect@99comlabs.co.in (mailto:connect@99comlabs.co.in)
 *    - Preserved Support Desk: support@99comlabs.co.in (/support/)
 *    - Registered Regional Location: Kottakkal, Malappuram district, Kerala, India - PIN 676304
 *      with honest placeholder [CONFIRM STREET ADDRESS].
 * 4. Google Rich Results JSON-LD Schemas: ContactPage, BreadcrumbList, LocalBusiness, FAQPage.
 * 5. Strict SEO Title (<60 chars) and Meta Description (<160 chars with Kerala/India keywords).
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const pageTitle = "Contact 99COMLABS — Software & IoT Lab Kerala";
const pageDescription = "Contact 99COMLABS in Kerala, India. Discuss web apps, IoT electronics, cloud systems, or digital growth. Call +91 9745551513 or request a free quote online.";
const breadcrumbs = [{ name: 'Contact', url: '/contact/' }];

// Frequently Asked Questions data
const faqs = [
  {
    question: "How quickly will I receive a quote after submitting my inquiry?",
    answer: "Our engineering team in Kerala reviews all technical inquiries within 24 business hours. If we need additional technical specifications, an engineer will call or message you directly. Comprehensive project proposals with milestone breakdowns are typically delivered within 2 to 3 working days."
  },
  {
    question: "Do you charge for initial consultation and architectural estimates?",
    answer: "No. Preliminary consultation, technical feasibility reviews, and high-level architecture estimates are 100% free with zero obligation. We believe in providing transparent, pragmatic advice so you can make informed technology investments before spending a single rupee."
  },
  {
    question: "Can we execute a Non-Disclosure Agreement (NDA) before sharing proprietary details?",
    answer: "Yes, absolutely. We routinely execute mutual NDAs with Indian and international clients before examining proprietary business processes, circuit board schematics, or database architectures. Your intellectual property and data confidentiality are fully protected."
  },
  {
    question: "Can I schedule an in-person meeting at your Kerala office?",
    answer: "Yes. Our registered office and engineering lab is located in Kottakkal, Malappuram district, Kerala (PIN 676304). We welcome prospective clients and partners for in-person project discovery sessions and hardware demonstrations by prior appointment."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <!-- Google Rich Results Structured Data (JSON-LD) -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://99comlabs.co.in/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Contact",
            "item": "https://99comlabs.co.in/contact/"
          }
        ]
      },
      {
        "@type": "ContactPage",
        "name": "Contact 99COMLABS — Let's Discuss Your Next Project",
        "description": pageDescription,
        "url": "https://99comlabs.co.in/contact/",
        "mainEntity": {
          "@type": "LocalBusiness",
          "name": "99COMLABS",
          "image": "https://99comlabs.co.in/images/logo.svg",
          "url": "https://99comlabs.co.in/",
          "telephone": "+91 9745551513",
          "email": "connect@99comlabs.co.in",
          "priceRange": "$$",
          "address": {
            "@type": "PostalAddress",
            
            "addressRegion": "Kerala",
            "postalCode": "676304",
            "addressCountry": "IN"
          },
          "contactPoint": [
            {
              "@type": "ContactPoint",
              "telephone": "+91 9745551513",
              "contactType": "sales",
              "areaServed": "IN",
              "availableLanguage": ["en", "ml"]
            },
            {
              "@type": "ContactPoint",
              "email": "support@99comlabs.co.in",
              "contactType": "customer support",
              "url": "https://99comlabs.co.in/support/"
            }
          ]
        }
      },
      {
        "@type": "LocalBusiness",
        "name": "99COMLABS",
        "image": "https://99comlabs.co.in/images/logo.svg",
        "url": "https://99comlabs.co.in/",
        "telephone": "+91 9745551513",
        "email": "connect@99comlabs.co.in",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          
          "addressRegion": "Kerala",
          "postalCode": "676304",
          "addressCountry": "IN"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map(faq => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      }
    ]
  })} />

  <!-- Hero Header Section -->
  <section class="py-12 sm:py-16 bg-surface-light border-b border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-content-primary mb-6 leading-tight">
          Let's Discuss Your Next Project
        </h1>

        <p class="text-base sm:text-lg text-content-secondary leading-relaxed mb-8">
          Have a custom software, IoT hardware, cloud architecture, or digital growth project in mind? Share your specifications with our solutions team for pragmatic architecture advice, realistic delivery timelines, and a transparent quote.
        </p>

        </div>
    </div>
  </section>

  <!-- Main Conversion Hub: Form + Direct Channels (2-Column Grid) -->
  <section class="py-12 sm:py-16 bg-surface-muted">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: Interactive Contact Form & Workflow Explanation (7 cols) -->
        <div class="lg:col-span-7 space-y-8">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h2 class="font-heading text-2xl sm:text-3xl font-bold text-content-primary">
                Send a Project Inquiry
              </h2>
              
            </div>
            <p class="text-sm text-content-secondary leading-relaxed mb-6">
              Complete the form below with your project goals. All submissions are sent directly to our lead solution architects with strict commercial confidentiality.
            </p>

            <!-- Embedded Accessible ContactForm Component -->
            <ContactForm />
          </div>

          <!-- What Happens Next Process Card -->
          <div class="bg-surface-light border border-line-light rounded-xl p-6 sm:p-7 shadow-card">
            <h3 class="font-heading text-lg font-bold text-content-primary mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              <span>Our Transparent 3-Step Inquiry Process</span>
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
              <div class="p-3.5 rounded-lg bg-surface-muted border border-line-light">
                <div class="font-mono text-xs font-bold text-brand-700 mb-1">STEP 01</div>
                <div class="font-semibold text-content-primary mb-1">Technical Review</div>
                <p class="text-xs text-content-muted leading-relaxed">
                  Engineers review requirements for architecture suitability within 24 hours.
                </p>
              </div>

              <div class="p-3.5 rounded-lg bg-surface-muted border border-line-light">
                <div class="font-mono text-xs font-bold text-brand-700 mb-1">STEP 02</div>
                <div class="font-semibold text-content-primary mb-1">Direct Discussion</div>
                <p class="text-xs text-content-muted leading-relaxed">
                  Call or WhatsApp with a senior engineer to refine specifications. No sales fluff.
                </p>
              </div>

              <div class="p-3.5 rounded-lg bg-surface-muted border border-line-light">
                <div class="font-mono text-xs font-bold text-brand-700 mb-1">STEP 03</div>
                <div class="font-semibold text-content-primary mb-1">Fixed Scope Proposal</div>
                <p class="text-xs text-content-muted leading-relaxed">
                  Clear quote with milestone timeline, deliverables, and 100% code ownership.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Direct Contact Information & Trust Card (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Primary Contact Details Card -->
          <div class="bg-surface-light border border-line-light rounded-2xl p-6 sm:p-8 shadow-card space-y-6">
            <h2 class="font-heading text-xl font-bold text-content-primary pb-4 border-b border-line-light">
              Direct Contact Channels
            </h2>

            <!-- Channel 1: Phone -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-brand-50 border border-brand-200 flex items-center justify-center text-brand-700 flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="flex-grow">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-content-subtle mb-0.5">
                  Direct Phone Call
                </h3>
                <a
                  href="tel:+919745551513"
                  class="text-base font-bold text-content-primary hover:text-brand-700 transition-colors"
                >
                  +91 9745551513
                </a>
                <p class="text-xs text-content-muted mt-0.5">
                  Mon – Sat, 9:00 AM – 6:30 PM IST (Direct engineer response)
                </p>
              </div>
            </div>

            <!-- Channel 2: WhatsApp -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-700 flex-shrink-0">
                <svg class="w-5 h-5 text-whatsapp-bright fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.025 3.312l-.727 2.654 2.721-.713c.978.534 1.773.816 2.748.816 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.769-5.766-5.769zm10.165 5.767c0 5.619-4.572 10.191-10.193 10.191-1.774 0-3.447-.461-4.908-1.265l-5.637 1.479 1.507-5.504c-.893-1.522-1.393-3.292-1.393-5.176 0-5.621 4.573-10.193 10.194-10.193 5.621 0 10.193 4.572 10.193 10.192z" />
                </svg>
              </div>
              <div class="flex-grow">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-content-subtle mb-0.5">
                  WhatsApp Messaging
                </h3>
                <a
                  href="https://wa.me/919745551513?text=Hello%2099COMLABS%2C%20I%20would%20like%20to%20discuss%20a%20project."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-base font-bold text-whatsapp-hover hover:text-whatsapp-base transition-colors"
                >
                  +91 9745551513
                </a>
                <p class="text-xs text-content-muted mt-0.5">
                  Fast messaging for initial questions, links, and documents
                </p>
              </div>
            </div>

            <!-- Channel 3: Official Inquiries Email -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-brand-50 border border-brand-200 flex items-center justify-center text-brand-700 flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="flex-grow">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-content-subtle mb-0.5">
                  Official Email Inquiries
                </h3>
                <a
                  href="mailto:connect@99comlabs.co.in"
                  class="text-base font-bold text-content-primary hover:text-brand-700 transition-colors break-all"
                >
                  connect@99comlabs.co.in
                </a>
                <p class="text-xs text-content-muted mt-0.5">
                  Best for RFPs, technical documents, and formal contracts
                </p>
              </div>
            </div>

            <!-- Channel 4: Preserved Existing Support Desk -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-surface-subtle border border-line-medium flex items-center justify-center text-content-secondary flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </div>
              <div class="flex-grow">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-content-subtle mb-0.5">
                  Existing Client Support Desk
                </h3>
                <div class="flex flex-wrap items-center gap-2">
                  <a
                    href="/support/"
                    class="text-sm font-bold text-brand-700 hover:text-brand-900 underline"
                  >
                    Open Support Desk (/support/)
                  </a>
                </div>
                <p class="text-xs text-content-muted mt-0.5">
                  Active clients with maintenance contracts: submit tickets online via the client support portal.
                </p>
              </div>
            </div>

            <!-- Channel 5: Location -->
            <div class="flex items-start gap-4 pt-2 border-t border-line-light">
              <div class="w-10 h-10 rounded-lg bg-surface-subtle border border-line-medium flex items-center justify-center text-content-secondary flex-shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="flex-grow">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-content-subtle mb-0.5">
                  Location
                </h3>
                <p class="text-sm text-content-primary font-mono font-bold">
                  IN-676304
                </p>
              </div>
            </div>
          </div>

          <!-- Trust & Commercial Guarantees Card -->
          <div class="bg-surface-light border border-line-light rounded-2xl p-6 shadow-card space-y-4">
            <h3 class="font-heading text-base font-bold text-content-primary flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Our Client Commitments</span>
            </h3>

            <ul class="text-xs sm:text-sm text-content-secondary space-y-3">
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-700 mt-2 flex-shrink-0" aria-hidden="true"></span>
                <span><strong class="text-content-primary">100% Code Ownership:</strong> All custom source code, schematics, and configurations belong entirely to you upon project handover.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-700 mt-2 flex-shrink-0" aria-hidden="true"></span>
                <span><strong class="text-content-primary">Zero Vendor Lock-in:</strong> We use standard open-source frameworks, portable Docker containers, and documented architectures.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-700 mt-2 flex-shrink-0" aria-hidden="true"></span>
                <span><strong class="text-content-primary">Direct Engineer Access:</strong> You communicate directly with the software and electronics engineers building your project.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-700 mt-2 flex-shrink-0" aria-hidden="true"></span>
                <span><strong class="text-content-primary">Clear Milestone Payments:</strong> Fixed-price phases tied to measurable milestone deliverables. No unexpected surprises.</span>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Frequently Asked Questions Section (Accordions) -->
  <section class="py-14 sm:py-20 bg-surface-light border-t border-line-light">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-brand-700">
          Got Questions?
        </span>
        <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-content-primary mt-2 mb-4">
          Frequently Asked Questions About Quotes
        </h2>
        <p class="text-base text-content-secondary max-w-2xl mx-auto">
          Honest answers to common questions about our scoping process, pricing, non-disclosure agreements, and project timelines.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-surface-muted border border-line-light rounded-xl overflow-hidden transition-colors hover:border-line-medium">
            <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer list-none select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-xl">
              <span class="font-heading text-base sm:text-lg font-semibold text-content-primary group-hover:text-brand-700 transition-colors">
                {faq.question}
              </span>
              <span class="flex-shrink-0 ml-2 w-7 h-7 rounded-full bg-surface-light border border-line-light flex items-center justify-center text-content-muted group-open:rotate-180 transition-transform duration-200" aria-hidden="true">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 sm:px-6 sm:pb-6 text-sm sm:text-base text-content-secondary leading-relaxed border-t border-line-light/50 pt-4">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Support Desk Rescue Banner -->
  <section class="py-10 bg-surface-muted border-t border-line-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 sm:p-8 rounded-2xl bg-white border border-line-light shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200 mb-2">
            Active Clients
          </span>
          <h2 class="font-heading text-lg sm:text-xl font-bold text-content-primary mb-1">
            Looking for the existing client support desk?
          </h2>
          <p class="text-sm text-content-secondary max-w-xl">
            If you have an active hosting, server maintenance, or software SLA with 99COMLABS, you can open a prioritized ticket (#99LAB-) in our preserved Helpdesk.
          </p>
        </div>
        <a
          href="/support/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-brand-700 hover:text-white bg-brand-50 hover:bg-brand-700 border border-brand-200 hover:border-brand-700 rounded-lg transition-colors min-h-touch flex-shrink-0"
        >
          <span>Visit Helpdesk (/support/)</span>
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
