---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Page Not Found (404)";
// BaseLayout appends " | 99COMLABS" -> 20 + 12 = 32 chars (strictly < 60)
const pageDescription = "The requested page could not be found. Explore 99COMLABS services, visit our home page, or contact our engineering team directly on WhatsApp.";
// 145 chars (strictly < 160)

const breadcrumbs = [
  { name: 'Page Not Found', url: '/404.html' }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  noindex={true}
  breadcrumbs={breadcrumbs}
>
  <section class="bg-surface-light py-16 sm:py-24 min-h-[70vh] flex items-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left">
      
      <!-- 404 Badge & Headline -->
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 border border-red-200 text-xs font-semibold text-red-700 mb-6">
          <span class="w-2 h-2 rounded-full bg-red-500" aria-hidden="true"></span>
          HTTP 404 • Resource Not Found
        </div>

        <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-content-primary mb-6 leading-tight">
          We couldn't find the page you're looking for.
        </h1>

        <p class="text-base sm:text-lg text-content-secondary leading-relaxed mb-8">
          The link you followed may be outdated, mistyped, or the page was relocated during our website upgrade. Don't worry—everything you need is easy to find from here.
        </p>
      </div>

      <!-- Quick Recovery Hub Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-8 text-left">
        
        <!-- Card 1: Home -->
        <a
          href="/"
          class="p-5 rounded-xl border border-line-light bg-surface-muted hover:bg-surface-light hover:border-brand-300 hover:shadow-sm transition-all duration-150 flex items-start gap-4 group"
        >
          <div class="w-10 h-10 rounded-lg bg-brand-50 text-brand-700 flex items-center justify-center flex-shrink-0 group-hover:bg-brand-700 group-hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <div>
            <h2 class="font-heading font-bold text-content-primary group-hover:text-brand-700 transition-colors">
              Return to Homepage
            </h2>
            <p class="text-xs sm:text-sm text-content-muted mt-0.5">
              Explore our core capabilities, engineering ethos, and verified project case studies.
            </p>
          </div>
        </a>

        <!-- Card 2: Services -->
        <a
          href="/services/"
          class="p-5 rounded-xl border border-line-light bg-surface-muted hover:bg-surface-light hover:border-brand-300 hover:shadow-sm transition-all duration-150 flex items-start gap-4 group"
        >
          <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center flex-shrink-0 group-hover:bg-blue-700 group-hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div>
            <h2 class="font-heading font-bold text-content-primary group-hover:text-blue-700 transition-colors">
              Engineering Services
            </h2>
            <p class="text-xs sm:text-sm text-content-muted mt-0.5">
              Custom software, smart IoT hardware, cloud servers, and local search growth.
            </p>
          </div>
        </a>

        <!-- Card 3: Blog -->
        <a
          href="/blog/"
          class="p-5 rounded-xl border border-line-light bg-surface-muted hover:bg-surface-light hover:border-brand-300 hover:shadow-sm transition-all duration-150 flex items-start gap-4 group"
        >
          <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-700 flex items-center justify-center flex-shrink-0 group-hover:bg-purple-700 group-hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div>
            <h2 class="font-heading font-bold text-content-primary group-hover:text-purple-700 transition-colors">
              Technology Guides
            </h2>
            <p class="text-xs sm:text-sm text-content-muted mt-0.5">
              Practical cost guides, IoT sensor tutorials, and cloud hosting comparisons.
            </p>
          </div>
        </a>

        <!-- Card 4: Support Desk -->
        <a
          href="/support/"
          class="p-5 rounded-xl border border-line-light bg-surface-muted hover:bg-surface-light hover:border-brand-300 hover:shadow-sm transition-all duration-150 flex items-start gap-4 group"
        >
          <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0 group-hover:bg-emerald-700 group-hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <div>
            <h2 class="font-heading font-bold text-content-primary group-hover:text-emerald-700 transition-colors">
              Client Support Helpdesk
            </h2>
            <p class="text-xs sm:text-sm text-content-muted mt-0.5">
              Submit an issue ticket or access engineering assistance for active projects.
            </p>
          </div>
        </a>

      </div>

      <!-- Direct Rescue Banner -->
      <div class="mt-10 p-6 rounded-xl border border-line-light bg-surface-muted flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="font-semibold text-content-primary text-sm sm:text-base">
            Looking for something specific or experiencing an urgent issue?
          </p>
          <p class="text-xs sm:text-sm text-content-muted">
            Connect with our engineering team directly via WhatsApp or telephone.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://wa.me/919745551513?text=Hello%2099COMLABS%2C%20I%20hit%20a%20404%20error%20page%20and%20need%20help."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-semibold text-white bg-whatsapp-base hover:bg-whatsapp-hover rounded-lg transition-colors min-h-touch"
          >
            <span>Message on WhatsApp</span>
          </a>
          <a
            href="tel:+919745551513"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-semibold text-content-secondary hover:text-brand-700 bg-surface-light border border-line-light rounded-lg transition-colors min-h-touch"
          >
            <span>Call +91 9745551513</span>
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
