# ==============================================================================
# 99COMLABS - Apache HTTP Server Configuration (.htaccess)
# Domain: https://99comlabs.co.in/
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL Rewriting & Canonical Redirects (mod_rewrite)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1.1 Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1.2 Force Canonical Apex Domain (redirect www to non-www)
  RewriteCond %{HTTP_HOST} ^www\.99comlabs\.co\.in$ [NC]
  RewriteRule ^(.*)$ https://99comlabs.co.in/$1 [L,R=301]

  # 1.3 Canonical Root index.html Redirect
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
  RewriteRule ^index\.html$ https://99comlabs.co.in/ [L,R=301]

  # 1.4 Canonical Support index.html Redirect
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /support/index\.html\ HTTP/ [NC]
  RewriteRule ^support/index\.html$ https://99comlabs.co.in/support/ [L,R=301]

  # 1.5 Legacy .html URL Redirects (root and nested) to Clean Directory Routes
  # Explicitly excludes 404.html to avoid error document rewrite loops
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([a-zA-Z0-9_\-/]+)\.html [NC]
  RewriteRule ^([a-zA-Z0-9_\-/]+)\.html$ https://99comlabs.co.in/$1/ [L,R=301]

  # 1.6 Enforce Trailing Slash on Directory and Page Routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://99comlabs.co.in/$1/ [L,R=301]

  # 1.7 Sitemap Index Alias (Redirect legacy /sitemap.xml to Astro sitemap-index.xml)
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# 2. Custom Error Documents
# ------------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# 3. Security Headers (mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Protect against clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Enable XSS protection filter
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict sensitive browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HTTP Strict Transport Security (HSTS) - 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ------------------------------------------------------------------------------
# 4. Gzip / Deflate Compression (mod_deflate)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 5. Browser Caching & Cache-Control (mod_expires)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: Always revalidate for instant updates
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # Static hashed assets (Astro chunks)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images and Icons
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 6. Correct MIME Types (mod_mime)
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>
